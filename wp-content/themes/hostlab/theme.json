{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "ink", "color": "#14121F", "name": "Ink" },
        { "slug": "purple-dark", "color": "#0f0a5c", "name": "Purple Dark" },
        { "slug": "purple", "color": "#574ea3", "name": "Purple" },
        { "slug": "purple-light", "color": "#9e91eb", "name": "Purple Light" },
        { "slug": "lime", "color": "#c7f36b", "name": "Lime" },
        { "slug": "gray", "color": "#6B6B78", "name": "Gray" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ]
    },
    "layout": {
      "contentSize": "780px",
      "wideSize": "1200px"
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "grift",
          "fontFamily": "'Grift', sans-serif",
          "name": "Grift"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.95rem", "name": "Small" },
        { "slug": "medium", "size": "1.15rem", "name": "Medium" },
        { "slug": "large", "size": "2.25rem", "name": "Large" },
        { "slug": "x-large", "size": "3.25rem", "name": "Extra Large" }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--grift)"
    },
    "color": {
      "text": "#14121F",
      "background": "#FFFFFF"
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}